    {
      "name": "wrong-direction-label-fails-authentication",
      "sections": [
        "3.4",
        "9.1",
        "11.3 Q3"
      ],
      "note": "The direction label is bound TWICE — in the AAD (§9.1) and in the §9.4 key derivation — so an ordinary cross-direction delivery differs in two places at once and proves nothing about either. Here the receiver's AEAD key is pinned to the sender's through the session's own test hook, so the ONLY difference is the label, and the authentication failure is attributable to it alone.",
      "inputs": {
        "envelope": {
          "$bytes": "01010100000000000000000000000078e1c2a3813c1781de7eb313d58cfbf7e22a1f2007f93348e4a5"
        },
        "senderDirection": "c2n",
        "receiverDirectionLabelUsed": "n2c",
        "testOnlyPinnedAeadKey": {
          "$bytes": "99a6a5b035262ec751e2623691d6afe37a3328ab418d4df6a7cbdb445efe86ad"
        }
      },
      "expected": {
        "senderAad": {
          "$bytes": "0101010000000000000000000000005f0ca343c437b1aa35e1a1c6eff4d2be244dde8dd384ff023559a2cee8c38a6763326e"
        },
        "receiverAad": {
          "$bytes": "0101010000000000000000000000005f0ca343c437b1aa35e1a1c6eff4d2be244dde8dd384ff023559a2cee8c38a676e3263"
        },
        "aadsDifferOnlyInTheTrailingLabel": true,
        "received": {
          "kind": "fatal",
          "reason": "authentication_failed"
        },
        "aeadKeysAlsoDifferByDirection": true,
        "disposition": "FATAL-POST"
      }
    },
